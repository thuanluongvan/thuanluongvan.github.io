<style>
  body {
    background-color: #161616;
    color: #a1a1aa;
    font-family: "DM Sans", sans-serif;
    font-weight: 400;

    * {
      margin: 0;
    }

    > * {
      margin: 0 auto;
      width: 60%;
    }

    a {
      text-decoration: none;
      color: #8ab4f8;
    }

    main {
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        color: #f2f2f2;
      }

      h2 {
        font-size: 4rem;
      }

      section {
        display: flex;
        gap: 50px;
      }
    }
  }
</style>
